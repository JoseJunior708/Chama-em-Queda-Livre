# Copia este ficheiro para .env e preenche a chave. NUNCA envies o .env para o Git.

# Chave da API do Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de geração (Flash). Alternativas: gemini-3.8-flash, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.6-flash

# Modelo de embeddings (multilingue: perguntas em PT sobre documentos em EN)
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIM=768

# Opcional
# DOCS_DIR=data/docs
# INDEX_DIR=data/index
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200
# EMBED_BATCH=50
# MAX_RETRIES=6
# TOP_K=8
# PESO_VETORIAL=0.65
# VERIFY_JUDGE=true
